#!/usr/bin/env bash
# Build, verify and publish a hopper release. Nothing is published unless every check passes,
# and a published release is verified the way users receive it.
#
#   scripts/release build   X.Y.Z   gates, static build, package, verify the package (no network writes)
#   scripts/release publish X.Y.Z   everything in build, then push main, tag, create the release,
#                                   and verify it from the outside
#   scripts/release verify  X.Y.Z   only the outside checks, for a release already published
#
# The package layout is a contract with every hopper already installed: `hopper self-update`
# unpacks with the first path component stripped (hopper-core java::install::extract_tar_gz),
# and install.sh finds the binary anywhere in the archive. So the archive holds exactly one
# top-level directory, hopper-vX.Y.Z-x86_64-linux/, with the binary directly inside it.
# 0.2.0 and 0.2.1 shipped flat archives and could not be self-updated to; never again.
#
# Assets are never replaced once published: GitHub's download CDN keeps serving the old bytes
# for minutes, so a fix-up upload is seen by some users and not others. A broken release gets
# a new patch version instead.
set -euo pipefail

REPO="ptMuta/hopper"
TARGET_TRIPLE="x86_64-unknown-linux-musl"
PLATFORM="x86_64-linux"
IMAGE="docker.io/library/debian:12-slim"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
die() { printf 'release: %s\n' "$*" >&2; exit 1; }

usage() {
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
}

[ $# -eq 2 ] || usage
MODE="$1"
VERSION="${2#v}"
case "$MODE" in build | publish | verify) ;; *) usage ;; esac
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "version must be X.Y.Z, got $VERSION"

TAG="v$VERSION"
NAME="hopper-$TAG-$PLATFORM"
TARBALL="$NAME.tar.gz"
DIST="$ROOT/target/release-dist/$TAG"
NOTES="docs/releases/$VERSION.md"

need() { command -v "$1" >/dev/null 2>&1 || die "needs $1"; }

# ---------------------------------------------------------------- preconditions

preconditions() {
    need cargo
    need cargo-zigbuild
    need podman
    need gh
    need file
    local declared
    declared="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
    [ "$declared" = "$VERSION" ] || die "Cargo.toml says $declared, releasing $VERSION; bump it first"
    grep -q "hopper-core = { path = \"../hopper-core\", version = \"$VERSION\" }" crates/hopper/Cargo.toml ||
        die "crates/hopper/Cargo.toml must depend on hopper-core $VERSION"
    [ -f "$NOTES" ] || die "missing release notes $NOTES"
    head -n 1 "$NOTES" | grep -qx "# Hopper $VERSION" || die "$NOTES must start with '# Hopper $VERSION'"
    if [ -n "$(git status --porcelain)" ]; then
        die "working tree is not clean"
    fi
}

publish_preconditions() {
    [ "$(git rev-parse --abbrev-ref HEAD)" = main ] || die "release from main"
    git fetch -q origin main --tags
    git merge-base --is-ancestor origin/main HEAD || die "main is behind origin/main; pull first"
    if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
        die "tag $TAG already exists locally"
    fi
    if git ls-remote --exit-code --tags origin "refs/tags/$TAG" >/dev/null 2>&1; then
        die "tag $TAG already exists on origin"
    fi
    if gh release view "$TAG" -R "$REPO" >/dev/null 2>&1; then
        die "release $TAG already exists; publish a new patch version instead of replacing assets"
    fi
}

# ---------------------------------------------------------------- build

gates() {
    say "Checking formatting, lints and tests"
    cargo fmt --all --check
    cargo clippy --locked --all-targets -- -D warnings
    cargo test --locked --quiet
}

build() {
    say "Building a static $TARGET_TRIPLE binary"
    cargo zigbuild --locked --release --target "$TARGET_TRIPLE" --quiet
    local bin="target/$TARGET_TRIPLE/release/hopper"
    file "$bin" | grep -q "statically linked" || die "$bin is not statically linked"
    [ "$("$bin" --version)" = "hopper $VERSION" ] || die "binary reports $("$bin" --version)"

    say "Packaging $TARBALL"
    rm -rf "$DIST"
    mkdir -p "$DIST/$NAME/docs/releases"
    install -m 755 "$bin" "$DIST/$NAME/hopper"
    install -m 755 install.sh "$DIST/$NAME/install.sh"
    install -m 644 README.md LICENSE "$DIST/$NAME/"
    install -m 644 docs/hosting.md "$DIST/$NAME/docs/"
    install -m 644 docs/releases/*.md "$DIST/$NAME/docs/releases/"
    # Reproducible: fixed owner, order and timestamps (the release commit's).
    local stamp
    stamp="@$(git log -1 --format=%ct)"
    tar -C "$DIST" --sort=name --owner=0 --group=0 --numeric-owner --mtime="$stamp" \
        -cf - "$NAME" | gzip -n -9 >"$DIST/$TARBALL"
    (cd "$DIST" && sha256sum "$TARBALL" >SHA256SUMS)
    rm -rf "${DIST:?}/$NAME"
}

# ---------------------------------------------------------------- package checks

verify_package() {
    say "Verifying the package layout"
    local listing
    listing="$(tar -tzf "$DIST/$TARBALL")"
    if grep -v "^$NAME/" <<<"$listing" | grep -q .; then
        die "entries outside $NAME/:"$'\n'"$(grep -v "^$NAME/" <<<"$listing")"
    fi
    grep -qx "$NAME/hopper" <<<"$listing" || die "$NAME/hopper is missing"
    (cd "$DIST" && sha256sum -c --quiet SHA256SUMS) || die "SHA256SUMS does not match"

    say "Verifying what self-update sees (first path component stripped)"
    local probe
    probe="$(mktemp -d)"
    tar -xzf "$DIST/$TARBALL" -C "$probe" --strip-components=1
    [ -x "$probe/hopper" ] || die "self-update would find no hopper binary"
    [ "$("$probe/hopper" --version)" = "hopper $VERSION" ] || die "unpacked binary has the wrong version"
    rm -rf "$probe"

    say "Verifying install.sh --from in a clean $IMAGE as a non-root user"
    podman run --rm --user 1000:1000 -e HOME=/tmp/home -v "$DIST:/dist:ro,Z" "$IMAGE" sh -euc "
        mkdir -p /tmp/home
        tar -xzf /dist/$TARBALL -C /tmp
        sh /tmp/$NAME/install.sh --from /dist/$TARBALL --no-modify-path >/dev/null
        test \"\$(/tmp/home/.local/bin/hopper --version)\" = 'hopper $VERSION'
        /tmp/home/.local/bin/hopper providers >/dev/null
        set +e
        /tmp/home/.local/bin/hopper install </dev/null 2>/dev/null
        test \$? -eq 2
    " || die "install.sh from the package failed"
}

# ---------------------------------------------------------------- publish

publish() {
    say "Pushing main and tag $TAG"
    git push -q origin main
    git tag -a "$TAG" -m "hopper $VERSION"
    git push -q origin "$TAG"
    say "Creating release $TAG"
    gh release create "$TAG" -R "$REPO" --title "hopper $VERSION" --notes-file "$NOTES" \
        "$DIST/$TARBALL" "$DIST/SHA256SUMS"
}

# ---------------------------------------------------------------- outside checks

previous_tag() {
    gh release list -R "$REPO" --exclude-drafts --exclude-pre-releases --limit 20 \
        --json tagName -q '.[].tagName' | grep -vx "$TAG" | sort -V | tail -n 1
}

verify_published() {
    local url="https://github.com/$REPO/releases/download/$TAG"
    # The API serves the uploaded bytes at once; the public URLs lag behind it.
    local expected
    expected="$(gh release download "$TAG" -R "$REPO" -p SHA256SUMS -O -)"
    if [ "$MODE" = publish ]; then
        [ "$expected" = "$(cat "$DIST/SHA256SUMS")" ] || die "uploaded SHA256SUMS differs from the built one"
    fi

    say "Waiting for the public download URLs to serve this release"
    local tries=0
    until [ "$(curl -fsSL "$url/SHA256SUMS" 2>/dev/null)" = "$expected" ]; do
        tries=$((tries + 1))
        [ $tries -lt 60 ] || die "public SHA256SUMS never matched after 10 minutes"
        sleep 10
    done
    local probe
    probe="$(mktemp -d)"
    curl -fsSL "$url/$TARBALL" -o "$probe/$TARBALL"
    (cd "$probe" && printf '%s\n' "$expected" | sha256sum -c --quiet -) ||
        die "public tarball does not match SHA256SUMS"
    rm -rf "$probe"

    say "Verifying a fresh install with the published one-liner"
    podman run --rm "$IMAGE" sh -euc "
        apt-get -qq update >/dev/null && apt-get -qq install -y curl ca-certificates >/dev/null
        useradd -m u
        su u -c 'curl -fsSL https://raw.githubusercontent.com/$REPO/main/install.sh | sh -s -- --no-modify-path >/dev/null
                 test \"\$(~/.local/bin/hopper --version)\" = \"hopper $VERSION\"'
    " || die "fresh install from the one-liner did not give $VERSION"

    local previous
    previous="$(previous_tag)"
    [ -n "$previous" ] || {
        say "No earlier release to update from"
        return
    }
    if [ "$previous" = v0.2.0 ] || [ "$previous" = v0.2.1 ]; then
        say "Checking self-update from $previous (its own archive is flat, so it installs via its binary)"
    else
        say "Checking self-update from $previous"
    fi
    podman run --rm "$IMAGE" sh -euc "
        apt-get -qq update >/dev/null && apt-get -qq install -y curl ca-certificates >/dev/null
        useradd -m u
        su u -c 'set -eu
                 mkdir -p ~/old ~/bin
                 curl -fsSL https://github.com/$REPO/releases/download/$previous/hopper-$previous-$PLATFORM.tar.gz | tar -xz -C ~/old
                 cp \"\$(find ~/old -type f -name hopper | head -n 1)\" ~/bin/hopper
                 ~/bin/hopper self-update --yes >/dev/null
                 test \"\$(~/bin/hopper --version)\" = \"hopper $VERSION\"'
    " || die "self-update from $previous to $VERSION failed"
    say "Release $TAG verified: download, fresh install, and self-update from $previous"
}

# ---------------------------------------------------------------- main

case "$MODE" in
build)
    preconditions
    gates
    build
    verify_package
    say "Built and verified $DIST/$TARBALL (not published)"
    ;;
publish)
    preconditions
    publish_preconditions
    gates
    build
    verify_package
    publish
    verify_published
    ;;
verify)
    need gh
    need podman
    need curl
    verify_published
    ;;
esac
